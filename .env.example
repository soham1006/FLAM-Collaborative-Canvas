# ===================================================
# Server Environment Variables (apps/server)
# ===================================================
PORT=4000
HOST=0.0.0.0
NODE_ENV=development

# Database Connection (Default: local SQLite or PostgreSQL)
# For local development with SQLite:
DATABASE_URL="file:./dev.db"
# For Neon / Supabase Serverless PostgreSQL:
# DATABASE_URL="postgresql://user:password@ep-xyz.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Client CORS & Allowed Origins
CORS_ORIGIN="http://localhost:5173"

# Rate Limiting & WebSocket Performance
WS_MAX_PAYLOAD_BYTES=65536
WS_RATE_LIMIT_MESSAGES_PER_SEC=60

# Debounced Persistence Settings (ms)
PERSISTENCE_FLUSH_INTERVAL_MS=2500

# ===================================================
# Client Environment Variables (apps/web)
# ===================================================
VITE_SERVER_HTTP_URL="http://localhost:4000"
VITE_SERVER_WS_URL="ws://localhost:4000/ws"
