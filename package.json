{
  "name": "flam-collaborative-canvas",
  "version": "1.0.0",
  "private": true,
  "description": "Real-time collaborative infinite canvas built for FLAM AI hiring assignment",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "dev:web": "npm run dev --workspace=@flam/web",
    "dev:server": "npm run dev --workspace=@flam/server",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present"
  },
  "keywords": [
    "canvas",
    "real-time",
    "collaboration",
    "websockets",
    "typescript",
    "flam-ai"
  ],
  "author": "",
  "license": "MIT"
}
